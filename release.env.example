# Copy to release.env (git-ignored) and fill in. Read by scripts/release.sh.
# See docs/release/RELEASE.md for where each value comes from.

# Permanent app identity. Use a domain you control; never change it after
# your first public release (it ties together settings, Keychain and login item).
DROPLET_BUNDLE_ID="com.yourdomain.droplet"
DROPLET_VERSION="1.0.0"
DROPLET_BUILD="1"
DROPLET_COPYRIGHT="© 2026 Your Name"
# The seller named on the website and in its terms and privacy policy.
DROPLET_OWNER="Your Name"
# DROPLET_COUNTRY="Norway"                         # shown after the seller's name
# DROPLET_ADDRESS="Street 1, 1234 City, Country"   # if your country requires it

# How the app is signed.
#  - Free (default): the name of the self-signed certificate you made in
#    Keychain Access (docs/release/RELEASE.md, "Free signing certificate").
#    Customers install with the one-line Terminal command.
#  - Later, with a paid Apple developer account: "Developer ID Application:
#    Your Name (TEAMID1234)" plus NOTARY_PROFILE; then the DMG also opens
#    with a plain double-click.
#  - "-" signs without any certificate (works, but macOS asks customers again
#    for folder and Keychain access after every update).
SIGNING_IDENTITY="Droplet Signing"
# NOTARY_PROFILE="droplet-notary"

# The https folder of Droplet's website; install.sh is served from it.
# Customers install with:  curl -fsSL <this folder>/install.sh | bash
#  - Free on GitHub: the website on GitHub Pages and the zip and DMG on a
#    GitHub release of this public repository (scripts/publish.sh does it):
#      DROPLET_DOWNLOAD_URL="https://yourname.github.io/droplet"
#      DROPLET_GITHUB_REPO="yourname/yourname.github.io"
#  - Your own web host: upload dist/site/ to this folder.
DROPLET_DOWNLOAD_URL="https://yourdomain.com/droplet"
# DROPLET_GITHUB_REPO="yourname/yourname.github.io"

# Lemon Squeezy: Store ID (Settings → Stores), product ID and optional
# variant ID (Products → … → copy ID), and the product's checkout link.
DROPLET_LS_STORE_ID=""
DROPLET_LS_PRODUCT_ID=""
DROPLET_LS_VARIANT_ID=""
DROPLET_CHECKOUT_URL="https://yourstore.lemonsqueezy.com/buy/xxxxxxxx"
# Shown on the website; set the same price in Lemon Squeezy.
# Single quotes: a $ inside double quotes would be read as a variable.
DROPLET_PRICE='US$4.99'
# The refund promise in the terms and on the download page.
DROPLET_REFUND_DAYS="14"
# Launch offer (1 = on, 0 = off): customers choose any price from US$0 up to
# DROPLET_PRICE, and every price is the same full license. The price chooser
# sends the choice as ?price=2.50 to DROPLET_LAUNCH_CHECKOUT_URL, an https
# address without ? or # that must check the price again and open the
# checkout (see WEBSITE-HANDOFF.md). Without it the page says checkout isn't
# open. During the offer, point DROPLET_CHECKOUT_URL (the app's Buy button) at
# the website's price section, for example https://yourdomain.com/#price.
# DROPLET_LAUNCH_OFFER="1"
# DROPLET_LAUNCH_CHECKOUT_URL="https://checkout.yourdomain.com/droplet"

# Shown in Settings. Support may be an email address or an https link.
DROPLET_WEBSITE_URL="https://yourdomain.com/droplet"
DROPLET_SUPPORT="support@yourdomain.com"
DROPLET_PRIVACY_URL="https://yourdomain.com/droplet/privacy/"

# universal (default), arm64 or x86_64
DROPLET_ARCH="universal"
